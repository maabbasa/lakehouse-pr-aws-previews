<mxfile host="app.diagrams.net"><diagram name="What happens during an output preview"><mxGraphModel dx="2800" dy="1600" pageWidth="2400" pageHeight="1400" page="1"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="bg" value="" vertex="1" parent="1" style="fillColor=#FFFFFF;strokeColor=none;"><mxGeometry as="geometry" x="0" y="0" width="2400" height="1400" /></mxCell><mxCell id="title" value="&lt;b&gt;What happens during an output preview&lt;/b&gt;&lt;br&gt;Build With Abbas | September 2026" vertex="1" parent="1" style="text;html=1;align=left;fontSize=36;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="50" y="35" width="2000" height="120" /></mxCell><mxCell id="capture" value="&lt;b&gt;1. Pin inputs&lt;/b&gt;&lt;br&gt;Orders snapshot + customers snapshot&lt;br&gt;Record run manifest" vertex="1" parent="1" style="rounded=1;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;fontSize=28;whiteSpace=wrap;"><mxGeometry as="geometry" x="80" y="250" width="620" height="200" /></mxCell><mxCell id="baseline" value="&lt;b&gt;2. Base version&lt;/b&gt;&lt;br&gt;PR base SQL&lt;br&gt;Write base output branch" vertex="1" parent="1" style="rounded=1;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;fontSize=28;whiteSpace=wrap;"><mxGeometry as="geometry" x="880" y="250" width="620" height="200" /></mxCell><mxCell id="candidate" value="&lt;b&gt;3. Candidate version&lt;/b&gt;&lt;br&gt;PR head SQL&lt;br&gt;Write candidate output branch" vertex="1" parent="1" style="rounded=1;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;fontSize=28;whiteSpace=wrap;"><mxGeometry as="geometry" x="1680" y="250" width="620" height="200" /></mxCell><mxCell id="cleanup" value="&lt;b&gt;6. Clean references&lt;/b&gt;&lt;br&gt;Drop owned tags and branches&lt;br&gt;Keep data files for safe maintenance" vertex="1" parent="1" style="rounded=1;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;fontSize=28;whiteSpace=wrap;"><mxGeometry as="geometry" x="80" y="850" width="620" height="220" /></mxCell><mxCell id="review" value="&lt;b&gt;5. Save review report&lt;/b&gt;&lt;br&gt;Actions summary + JSON artifact&lt;br&gt;Available after cleanup" vertex="1" parent="1" style="rounded=1;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;fontSize=28;whiteSpace=wrap;"><mxGeometry as="geometry" x="880" y="850" width="620" height="220" /></mxCell><mxCell id="compare" value="&lt;b&gt;4. Compare outputs&lt;/b&gt;&lt;br&gt;Same pinned input views&lt;br&gt;Main output snapshot unchanged" vertex="1" parent="1" style="rounded=1;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;fontSize=28;whiteSpace=wrap;"><mxGeometry as="geometry" x="1680" y="850" width="620" height="220" /></mxCell><mxCell id="p1" source="capture" target="baseline" value="" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;labelBackgroundColor=#F5F5F5;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="p2" source="baseline" target="candidate" value="" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;labelBackgroundColor=#F5F5F5;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="p3" source="candidate" target="compare" value="" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;labelBackgroundColor=#F5F5F5;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="p4" source="compare" target="review" value="" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;labelBackgroundColor=#F5F5F5;fontSize=11;exitX=0;exitY=0.5;entryX=1;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="p5" source="review" target="cleanup" value="" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;labelBackgroundColor=#F5F5F5;fontSize=11;exitX=0;exitY=0.5;entryX=1;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="note" value="An Iceberg snapshot manifest is per table; it is not an atomic database snapshot." vertex="1" parent="1" style="text;html=1;fontSize=29;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="200" y="1190" width="2000" height="100" /></mxCell></root></mxGraphModel></diagram></mxfile>